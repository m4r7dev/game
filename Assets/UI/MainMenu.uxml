<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ui:Style src="project://database/Assets/UI/MainMenu.uss" />
  <ui:VisualElement name="Root" class="menuRoot">

    <!-- Main menu -->
    <ui:VisualElement name="MainPanel" class="panel mainPanel">
      <ui:Label name="gameName" class="gameName">Shooter</ui:Label>

      <ui:VisualElement class="mainButtonColumn">
        <ui:Button name="btnHost" class="menuButton" text="Host" />
        <ui:Button name="btnServerList" class="menuButton" text="Server List" />
        <ui:Button name="btnSettings" class="menuButton" text="Settings" />
        <ui:Button name="btnExit" class="menuButton" text="Exit" />
      </ui:VisualElement>

      <ui:VisualElement class="hintBox">
        <ui:Label class="hintTitle">Premium Lobby</ui:Label>
        <ui:Label class="hintText">Wähle einen Modus oder passe Grafik an.</ui:Label>
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Host -->
    <ui:VisualElement name="HostPanel" class="panel hostPanel">
      <ui:Label class="panelTitle">Host</ui:Label>
      <ui:Button name="btnHostBack" class="backButton" text="&larr; Back" />

      <ui:VisualElement class="form">
        <ui:Label class="sectionLabel">Lobby Einstellungen</ui:Label>

        <ui:IntegerField name="hostPlayerCount" class="field" label="Spieler (2-4)" value="2" />
        <ui:TextField name="hostLobbyName" class="field" label="Lobby Name" value="Lobby 01" />

        <ui:VisualElement name="hostPublicRow" class="row">
          <ui:Toggle name="hostPublicToggle" text="Public (kein Passwort)" value="true" />
        </ui:VisualElement>

        <ui:VisualElement name="hostPasswordContainer" class="passwordContainer">
          <ui:TextField name="hostPasswordField" class="field" label="Passwort" value="" />
        </ui:VisualElement>

        <ui:Label name="hostError" class="errorLabel" />

        <ui:Button name="btnHostStart" class="primaryButton" text="Start" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Server List -->
    <ui:VisualElement name="ServerListPanel" class="panel serverListPanel">
      <ui:Label class="panelTitle">Server List</ui:Label>
      <ui:Button name="btnServerListBack" class="backButton" text="&larr; Back" />

      <ui:VisualElement class="listToolbar">
        <ui:TextField name="serverSearch" class="field searchField" label="Suche" value="" />
        <ui:Toggle name="serverPublicOnly" text="Nur Public" value="false" />
      </ui:VisualElement>

      <ui:VisualElement class="listArea">
        <ui:ListView name="serverListView" class="serverList" />
        <ui:Label name="serverEmptyLabel" class="emptyLabel" text="Keine Server gefunden." />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Settings -->
    <ui:VisualElement name="SettingsPanel" class="panel settingsPanel">
      <ui:Label class="panelTitle">Settings</ui:Label>
      <ui:Button name="btnSettingsBack" class="backButton" text="&larr; Back" />

      <ui:VisualElement class="form">
        <ui:Label class="sectionLabel">Grafik</ui:Label>

        <ui:DropdownField name="settingsFullscreenMode" class="field" label="Fullscreen" />
        <ui:DropdownField name="settingsResolution" class="field" label="Auflösung" />
        <ui:DropdownField name="settingsFpsCap" class="field" label="FPS Cap" />

        <ui:VisualElement class="settingsButtonsRow">
          <ui:Button name="btnSettingsApply" class="primaryButton" text="Apply" />
          <ui:Button name="btnSettingsDefaults" class="secondaryButton" text="Defaults" />
        </ui:VisualElement>

        <ui:Label name="settingsApplyLabel" class="applyLabel" text="" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Start overlay -->
    <ui:VisualElement name="StartOverlayPanel" class="panel overlayPanel">
      <ui:Label class="overlayTitle">Starting…</ui:Label>
      <ui:Label name="startStatusLabel" class="overlayStatus" text="" />
      <ui:VisualElement class="overlayProgressBar">
        <ui:VisualElement class="overlayProgressFill" />
      </ui:VisualElement>
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
