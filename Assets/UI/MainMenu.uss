/* Premium Shooter / Cartoon Brutalist UI */
/* No gradients; chunky outlines; high contrast. */

.menuRoot{
  -unity-fonts-family: "Arial";
  width: 100%;
  height: 100%;
  padding-left: 24px;
  padding-right: 24px;
  padding-top: 22px;
  padding-bottom: 18px;

  background-color: rgba(0,0,0,0.55);
  border-top-width: 0px;
}

.panel{
  display: none;
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: rgba(0,0,0,0.30);
  border-color: rgba(255,255,255,0.25);
  border-left-width: 3px;
  border-right-width: 3px;
  border-top-width: 3px;
  border-bottom-width: 3px;

  padding-left: 20px;
  padding-right: 20px;
  padding-top: 14px;
  padding-bottom: 14px;
  gap: 12px;
}

.mainPanel{
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
}

.gameName{
  font-size: 56px;
  font-weight: 900;
  letter-spacing: 1px;
  color: #FFFFFF;

  text-shadow: 2px 2px 0 #000000;
  border-width: 0px;
  -unity-text-align: upper-left;
}

.mainPanel > .gameName{
  margin-bottom: 18px;
}

.mainButtonColumn{
  display: flex;
  flex-direction: column;
  gap: 14px;

  position: absolute;
  left: 32px;
  top: 210px;
}

.menuButton{
  width: 320px;
  height: 58px;

  background-color: #111111;
  color: #FFFFFF;

  border-top-width: 4px;
  border-left-width: 4px;
  border-right-width: 4px;
  border-bottom-width: 4px;

  border-top-color: #FFFFFF;
  border-left-color: #FFFFFF;
  border-right-color: #FFFFFF;
  border-bottom-color: #FFFFFF;

  border-radius: 0px;

  font-size: 26px;
  font-weight: 900;

  text-align: center;
  -unity-text-align: middle-center;

  box-shadow: 6px 6px 0 rgba(0,0,0,0.55);
}

.menuButton:hover{
  background-color: #1a1a1a;
  box-shadow: 7px 7px 0 rgba(0,0,0,0.65);
}

.hintBox{
  position: absolute;
  left: 32px;
  bottom: 34px;
  width: 520px;

  background-color: rgba(10,10,10,0.65);
  border-top-width: 3px;
  border-left-width: 3px;
  border-right-width: 3px;
  border-bottom-width: 3px;
  border-color: rgba(255,255,255,0.7);

  padding: 14px;
  box-shadow: 6px 6px 0 rgba(0,0,0,0.5);
}

.hintTitle{
  font-size: 22px;
  font-weight: 900;
  color: #FFFFFF;
}

.hintText{
  margin-top: 6px;
  font-size: 16px;
  color: rgba(255,255,255,0.85);
}

.panelTitle{
  font-size: 36px;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 8px;
}

.backButton{
  width: 170px;
  height: 44px;
  background-color: #0b0b0b;
  color: #FFFFFF;

  border-top-width: 3px;
  border-left-width: 3px;
  border-right-width: 3px;
  border-bottom-width: 3px;

  border-color: #FFFFFF;

  font-size: 18px;
  font-weight: 900;

  box-shadow: 4px 4px 0 rgba(0,0,0,0.55);
  -unity-text-align: middle-center;
}

.form{
  width: 520px;
  max-width: 60%;
  flex-direction: column;
  gap: 10px;
}

.sectionLabel{
  font-size: 20px;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 6px;
}

.row{
  flex-direction: row;
  gap: 10px;
  align-items: center;
}

.field{
  height: 42px;
  border-top-width: 3px;
  border-left-width: 3px;
  border-right-width: 3px;
  border-bottom-width: 3px;
  border-color: #FFFFFF;

  background-color: rgba(15,15,15,0.85);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 700;
}

.passwordContainer{
  display: flex;
}

.errorLabel{
  color: #ff3b3b;
  font-size: 16px;
  font-weight: 900;
  min-height: 20px;
}

.primaryButton{
  width: 240px;
  height: 52px;

  background-color: #00c853;
  color: #000000;
  font-size: 24px;
  font-weight: 900;

  border-top-width: 4px;
  border-left-width: 4px;
  border-right-width: 4px;
  border-bottom-width: 4px;

  border-color: #FFFFFF;

  box-shadow: 7px 7px 0 rgba(0,0,0,0.55);
}

.secondaryButton{
  width: 220px;
  height: 44px;

  background-color: rgba(255,255,255,0.10);
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 900;

  border-top-width: 3px;
  border-left-width: 3px;
  border-right-width: 3px;
  border-bottom-width: 3px;

  border-color: #FFFFFF;

  box-shadow: 5px 5px 0 rgba(0,0,0,0.55);
}

.settingsButtonsRow{
  flex-direction: row;
  gap: 14px;
  margin-top: 8px;
  align-items: center;
}

.applyLabel{
  color: rgba(255,255,255,0.9);
  font-size: 14px;
  font-weight: 800;
  min-height: 20px;
}

.listToolbar{
  flex-direction: row;
  gap: 14px;
  align-items: center;
  margin-bottom: 10px;
}

.searchField{
  width: 340px;
}

.listArea{
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.serverList{
  flex-grow: 1;
  background-color: rgba(0,0,0,0.25);
  border-top-width: 3px;
  border-left-width: 3px;
  border-right-width: 3px;
  border-bottom-width: 3px;
  border-color: rgba(255,255,255,0.35);
}

.emptyLabel{
  margin-top: 30px;
  align-self: center;
  font-size: 18px;
  font-weight: 900;
  color: rgba(255,255,255,0.75);
}

.overlayPanel{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.overlayTitle{
  font-size: 40px;
  font-weight: 900;
  color: #FFFFFF;
  text-shadow: 2px 2px 0 #000000;
}

.overlayStatus{
  margin-top: 10px;
  font-size: 18px;
  font-weight: 800;
  color: rgba(255,255,255,0.9);
}

.overlayProgressBar{
  margin-top: 16px;
  width: 520px;
  height: 22px;
  background-color: rgba(255,255,255,0.10);
  border-top-width: 3px;
  border-left-width: 3px;
  border-right-width: 3px;
  border-bottom-width: 3px;
  border-color: rgba(255,255,255,0.65);
}

.overlayProgressFill{
  width: 33%;
  height: 100%;
  background-color: #00c853;
}
